#!/usr/bin/env python3
"""Create a consistent SQLite backup plus the app's other persistent files."""
import datetime
import os
import shutil
import sqlite3
import tarfile
import tempfile

data_dir = "/data"
backup_dir = "/backups"
stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
db_path = os.path.join(data_dir, "uvv.db")
if not os.path.isfile(db_path):
    raise SystemExit(f"Missing database: {db_path}")

os.makedirs(backup_dir, mode=0o700, exist_ok=True)
archive_path = os.path.join(backup_dir, f"uvv-{stamp}.tar.gz")
with tempfile.TemporaryDirectory(prefix="uvv-backup-") as temp_dir:
    snapshot_path = os.path.join(temp_dir, "uvv.db")
    source = sqlite3.connect(db_path, timeout=30)
    destination = sqlite3.connect(snapshot_path)
    try:
        source.backup(destination)
    finally:
        destination.close()
        source.close()

    for filename in ("logo.png", ".secret_key"):
        source_path = os.path.join(data_dir, filename)
        if os.path.isfile(source_path):
            shutil.copy2(source_path, os.path.join(temp_dir, filename))

    with tarfile.open(archive_path, "w:gz") as archive:
        for filename in os.listdir(temp_dir):
            archive.add(os.path.join(temp_dir, filename), arcname=filename)

os.chmod(archive_path, 0o600)
print(archive_path)
